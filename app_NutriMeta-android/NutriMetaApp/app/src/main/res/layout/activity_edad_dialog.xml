<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    tools:context=".EdadDialog">

    <!-- Etiqueta del campo -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_12"
        android:text="@string/campo_fecha_nacimiento"
        android:textColor="@color/blanco"
        android:textSize="@dimen/sp_16"
        android:textStyle="bold" />

    <!-- Campo que abre el calendario -->
    <TextView
        android:id="@+id/tvValorEdadDialog"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:background="@drawable/fondo_numero_stepper"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="@dimen/dp_16"
        android:text="@string/accion_seleccionar"
        android:textColor="@color/blanco"
        android:textSize="@dimen/sp_18"
        android:textStyle="bold" />

    <!-- Texto de ayuda -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:gravity="center"
        android:text="@string/ayuda_fecha_nacimiento"
        android:textColor="@color/color_subtitulo_objetivo"
        android:textSize="@dimen/sp_13" />

    <!-- Botón Guardar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuardarEdad"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_54"
        android:layout_marginTop="@dimen/dp_24"
        android:enabled="false"
        android:text="@string/btn_guardar"
        android:textAllCaps="false"
        android:textColor="@color/colors"
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        app:backgroundTint="@color/color_boton"
        app:cornerRadius="@dimen/dp_27" />

</LinearLayout>
