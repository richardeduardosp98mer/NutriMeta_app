<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/fondo_dialogo"
    app:cardCornerRadius="@dimen/dp_20"
    app:cardElevation="@dimen/dp_0">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dp_20">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titulo_dialogo_actividad"
                android:textColor="@color/blanco"
                android:textSize="@dimen/sp_20"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/subtitulo_dialogo_actividad"
                android:textColor="@color/color_subtitulo_objetivo"
                android:textSize="@dimen/sp_14" />

            <RadioGroup
                android:id="@+id/grupoActividad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:orientation="vertical">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioSedentario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_48"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/dp_8"
                    android:text="@string/actividad_opcion_sedentario"
                    android:textColor="@color/blanco"
                    android:textSize="@dimen/sp_14"
                    app:buttonTint="@color/color_boton" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioLigero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_48"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/dp_8"
                    android:text="@string/actividad_opcion_ligero"
                    android:textColor="@color/blanco"
                    android:textSize="@dimen/sp_14"
                    app:buttonTint="@color/color_boton" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioModerado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_48"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/dp_8"
                    android:text="@string/actividad_opcion_moderado"
                    android:textColor="@color/blanco"
                    android:textSize="@dimen/sp_14"
                    app:buttonTint="@color/color_boton" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioMuyActivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_48"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/dp_8"
                    android:text="@string/actividad_opcion_muy_activo"
                    android:textColor="@color/blanco"
                    android:textSize="@dimen/sp_14"
                    app:buttonTint="@color/color_boton" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/radioExtremo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_48"
                    android:gravity="center_vertical"
                    android:paddingVertical="@dimen/dp_8"
                    android:text="@string/actividad_opcion_extremo"
                    android:textColor="@color/blanco"
                    android:textSize="@dimen/sp_14"
                    app:buttonTint="@color/color_boton" />

            </RadioGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarActividad"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_16"
                android:enabled="false"
                android:text="@string/btn_guardar"
                android:textAllCaps="false"
                android:textColor="@color/colors"
                android:textSize="@dimen/sp_16"
                app:backgroundTint="@color/color_boton"
                app:cornerRadius="@dimen/dp_24" />
        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
