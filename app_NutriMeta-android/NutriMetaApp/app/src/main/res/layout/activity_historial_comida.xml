<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootHistorial"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nm_fondo"
    android:orientation="vertical">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/dp_12"
        android:paddingTop="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_20">

        <ImageView
            android:id="@+id/btnVolverHistorial"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ali_volver"
            android:padding="@dimen/dp_12"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/nm_texto"/>

        <TextView
            android:id="@+id/tvTituloHistorial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_4"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/nm_texto"
            android:textSize="@dimen/sp_22"
            android:textStyle="bold"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tvVacioHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/dp_24"
        android:text="@string/hist_vacio"
        android:textColor="@color/nm_secundario"
        android:textSize="@dimen/sp_14"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlatosHistorial"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/dp_20"
        android:paddingEnd="@dimen/dp_20"
        android:paddingBottom="@dimen/dp_12"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAgregarPlatoHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginEnd="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_16"
        android:text="@string/hist_agregar"
        android:textColor="@color/nm_texto"
        app:backgroundTint="@color/nm_boton"/>

</LinearLayout>
