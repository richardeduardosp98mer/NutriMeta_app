<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.dialogs.SexoDialog">

    <!-- Opción Hombre -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardOpcionHombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/fondo_opcion_dialogo"
        app:cardCornerRadius="@dimen/dp_20"
        app:cardElevation="@dimen/dp_0"
        app:strokeColor="@color/borde_tarjeta_objetivo"
        app:strokeWidth="@dimen/dp_1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_20"
            android:paddingVertical="@dimen/dp_16">

            <ImageView
                android:id="@+id/ivRadioHombre"
                android:layout_width="@dimen/dp_22"
                android:layout_height="@dimen/dp_22"
                android:contentDescription="@null"
                android:src="@drawable/ic_radio_inactivo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16"
                android:text="@string/opcion_sexo_hombre"
                android:textColor="@color/blanco"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Opción Mujer -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardOpcionMujer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/fondo_opcion_dialogo"
        app:cardCornerRadius="@dimen/dp_20"
        app:cardElevation="@dimen/dp_0"
        app:strokeColor="@color/borde_tarjeta_objetivo"
        app:strokeWidth="@dimen/dp_1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/dp_20"
            android:paddingVertical="@dimen/dp_16">

            <ImageView
                android:id="@+id/ivRadioMujer"
                android:layout_width="@dimen/dp_22"
                android:layout_height="@dimen/dp_22"
                android:contentDescription="@null"
                android:src="@drawable/ic_radio_inactivo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_16"
                android:text="@string/opcion_sexo_mujer"
                android:textColor="@color/blanco"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>