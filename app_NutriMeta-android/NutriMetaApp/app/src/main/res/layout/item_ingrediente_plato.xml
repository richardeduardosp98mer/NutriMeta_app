<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_12"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/nm_tarjeta"
    app:cardCornerRadius="@dimen/dp_20"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/dp_16"
        android:paddingTop="@dimen/dp_4"
        android:paddingEnd="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_4">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreIngrediente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/nm_texto"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvDetalleIngrediente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:textColor="@color/nm_acento"
                android:textSize="@dimen/sp_14"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/btnQuitarIngrediente"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ali_quitar"
            android:padding="@dimen/dp_12"
            android:src="@drawable/ic_close"
            app:tint="@color/nm_secundario"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
